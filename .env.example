# --- Database ---
# connection_limit is set deliberately, not left at the Prisma default:
# the ingestion process and the Next.js API server compete for the same
# pool (Addendum 2 Section A6). If you deploy the app and the ingest loop
# as separate processes/containers (see docker-compose.yml), each opens
# its own pool against this limit -- size it accordingly, or put PgBouncer
# in front of Postgres once you're running more than one instance of either.
DATABASE_URL="postgresql://pulse:pulse@localhost:5432/pulse?schema=public&connection_limit=10"

# --- Auth ---
# Both required -- there is no hardcoded fallback. The server fails fast at
# startup (see src/lib/env.ts, called from src/instrumentation.ts) if either
# is unset, rather than silently signing tokens with a guessable default.
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars-long"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars-long"

# --- Market data providers ---
# Yahoo Finance unofficial endpoints need no key (primary source).
# Alpha Vantage free tier key, used as fallback when Yahoo fails/rate-limits.
ALPHA_VANTAGE_API_KEY=""

# --- News (Tier 3, news-driver matching) ---
NEWS_API_KEY=""

# --- AI brief (Tier 3, Section 7C) ---
# If unset, the AI brief always renders the templated fallback (this is intended
# honest behavior, not a bug -- see README "Data freshness & fallback honesty").
ANTHROPIC_API_KEY=""

# --- Misc ---
NODE_ENV="development"
# How often the ingestion cron/poll should run, in seconds
INGEST_INTERVAL_SECONDS="60"
# Shared secret for POST /api/cron/ingest, if you trigger ingestion via an
# external scheduler instead of `npm run ingest` / a long-lived process.
CRON_SECRET=""
